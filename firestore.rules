rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Zero-Trust Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable security helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.token.email == userId ||
        request.auth.uid == userId
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate Profile Entities
    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'createdAt'])
        && data.keys().size() == 3
        && data.email is string
        && data.email.size() <= 128
        && data.displayName is string
        && data.displayName.size() <= 100;
    }

    // Helper to validate Session Logs
    function isValidSessionLog(data) {
      return data.keys().hasAll(['id', 'date', 'state', 'technique', 'rating', 'notes', 'userId'])
        && (data.keys().size() == 7 || (data.keys().size() == 8 && 'endState' in data))
        && data.id is string
        && data.id.size() <= 128
        && data.date is string
        && data.date.size() <= 100
        && data.state is string
        && data.state.size() <= 150
        && data.technique is string
        && data.technique.size() <= 150
        && (data.rating == null || data.rating is string)
        && (data.notes is string || data.notes == null)
        && data.userId is string
        && data.userId.size() <= 128
        && (!('endState' in data) || data.endState == null || data.endState is string);
    }

    // Rules for User Profiles and History nested logs
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && isValidProfile(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      match /history/{logId} {
        allow get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidSessionLog(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(logId) && isValidSessionLog(incoming()) && incoming().userId == userId;
        allow list: if isOwner(userId);
      }
    }
  }
}

# ANTHROPIC_API_KEY: Required for live Claude sessions (without it PeMA uses its built-in offline sessions).
# Put your real key in .env.local only. Never commit it.
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
# Optional: override the Claude model.
CLAUDE_MODEL="claude-sonnet-5-5"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE CLIENT ID: Required for real Google Identity login.
# Enable OAuth 2.0 Client credentials on your Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# MICROSOFT CLIENT ID: Required for real Microsoft login.
# Create an App Registration in Microsoft Azure Active Directory portal.
VITE_MICROSOFT_CLIENT_ID=

